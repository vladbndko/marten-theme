  "tokenColors": [
    { "scope": ["comment","punctuation.definition.comment","string.comment"], "settings": {"foreground":"#95979a","fontStyle":"italic"} },
    { "scope": ["keyword","storage","storage.type","storage.modifier","keyword.control","keyword.operator.new","keyword.operator.expression","keyword.operator.logical.python","keyword.other.import","variable.language.super"], "settings": {"foreground":"#ff8c2e"} },
    { "scope": ["keyword.operator","punctuation","meta.brace","punctuation.definition.tag","punctuation.separator","punctuation.terminator","punctuation.accessor"], "settings": {"foreground":"#95979a"} },
    { "scope": ["string","string.quoted","string.template","markup.inline.raw","markup.raw"], "settings": {"foreground":"#9dbf7a"} },
    { "scope": ["constant.character.escape","string.regexp","constant.other.placeholder","punctuation.definition.template-expression","punctuation.section.embedded"], "settings": {"foreground":"#ffcf66"} },
    { "scope": ["constant.numeric","constant.language","constant.other","constant.character","support.constant","variable.other.constant","variable.other.enummember","entity.other.attribute-name","meta.decorator","entity.name.function.decorator","punctuation.decorator"], "settings": {"foreground":"#c98fa6"} },
    { "scope": ["entity.name.function","support.function","meta.function-call.generic","variable.function","entity.name.function.macro"], "settings": {"foreground":"#7fa3c4"} },
    { "scope": ["entity.name.type","entity.name.class","entity.name.namespace","entity.other.inherited-class","support.type","support.class","storage.type.primitive","support.type.primitive","entity.name.tag","meta.type.annotation"], "settings": {"foreground":"#7fb8b5"} },
    { "scope": ["variable","variable.other","variable.parameter","meta.definition.variable"], "settings": {"foreground":"#e3e3e0"} },
    { "scope": ["variable.other.property","variable.other.object.property","support.variable.property","meta.object-literal.key","entity.name.tag.yaml","support.type.property-name"], "settings": {"foreground":"#9fbbd6"} },
    { "scope": ["variable.language","variable.language.this","variable.language.self"], "settings": {"foreground":"#c98fa6","fontStyle":"italic"} },
    { "scope": ["markup.heading","entity.name.section","markup.heading punctuation.definition.heading"], "settings": {"foreground":"#ff8c2e","fontStyle":"bold"} },
    { "scope": ["markup.bold"], "settings": {"foreground":"#e3e3e0","fontStyle":"bold"} },
    { "scope": ["markup.italic"], "settings": {"foreground":"#e3e3e0","fontStyle":"italic"} },
    { "scope": ["markup.underline.link","string.other.link","markup.link"], "settings": {"foreground":"#7fa3c4"} },
    { "scope": ["markup.list punctuation.definition.list.begin","beginning.punctuation.definition.list"], "settings": {"foreground":"#ff8c2e"} },
    { "scope": ["markup.quote"], "settings": {"foreground":"#95979a","fontStyle":"italic"} },
    { "scope": ["markup.inserted","punctuation.definition.inserted"], "settings": {"foreground":"#9dbf7a"} },
    { "scope": ["markup.deleted","punctuation.definition.deleted"], "settings": {"foreground":"#e85a44"} },
    { "scope": ["markup.changed","punctuation.definition.changed"], "settings": {"foreground":"#7fa3c4"} },
    { "scope": ["invalid","invalid.illegal"], "settings": {"foreground":"#e85a44"} },
    { "scope": ["invalid.deprecated"], "settings": {"foreground":"#f5c04a","fontStyle":"strikethrough"} }
  ],
